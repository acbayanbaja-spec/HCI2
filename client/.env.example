# Digital Guardian web client - environment template
# Copy to client/.env.local for local overrides. Only VITE_ prefixed values
# reach the browser, so this file must never contain a secret.

# Leave empty to call the API on the same origin (dev uses the Vite proxy,
# production uses the deployed API behind the same domain or a CORS origin).
VITE_API_BASE_URL=

# Origin the Vite dev proxy forwards /api to. Must match the API PORT.
VITE_DEV_API_ORIGIN=http://127.0.0.1:4000
