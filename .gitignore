# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo
coverage/

# Environment and secrets - never commit these
.env
.env.*
!.env.example

# Local database cluster data (dev-only embedded Postgres)
.pgdata/
.devdb/
pglog.txt

# Runtime artifacts
logs/
*.log
npm-debug.log*
.tmp/
tmp/

# Mail written to disk when SMTP is not configured. These files carry live
# email-verification and password-reset links, so they stay local.
server/.outbox/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test artifacts
.testdb/
server/.testdb/

# Local TLS material. The Supabase pooler root CA is public and is tracked on
# purpose, so PGSSL_ROOT_CERT can name the file instead of a pasted PEM blob.
server/*.pem
!server/supabase-root-ca.pem
