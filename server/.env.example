# ---------------------------------------------------------------------------
# Digital Guardian API - environment template
# Copy to server/.env and fill in real values. Never commit the .env file.
# `npm run db:start` generates a complete server/.env for local development.
# Regenerate random values any time with:  npm run gen:secrets
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Comma-separated browser origins allowed to call the API with credentials.
# Development default is the local Vite client. In production use the real
# deployment URL, e.g. CORS_ORIGINS=https://digital-guardian.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database --------------------------------------------------------------
# Local development (PostgreSQL started with `npm run db:start`):
DATABASE_URL=postgresql://guardian:change-me-local-only@127.0.0.1:5543/digital_guardian
# Supabase PostgreSQL (production). Use the pooled connection string and set
# PGSSL=true. Never hardcode real credentials, e.g.
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.pooler.supabase.com:6543/postgres
PGSSL=false
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
# For a TLS database, PGSSL=true verifies the server certificate. If your
# provider needs a private CA, point PGSSL_ROOT_CERT at the PEM contents.
# PGSSL_INSECURE=true disables verification - a last resort for a provider with
# a self-signed certificate, never for production.
PGSSL_ROOT_CERT=
PGSSL_INSECURE=false

# --- Auth secrets ----------------------------------------------------------
# Each must be at least 32 characters and all three must differ.
# DATA_ENCRYPTION_KEY is a 32-byte hex value used to encrypt MFA secrets at rest.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
DATA_ENCRYPTION_KEY=

# --- Cookie behaviour ------------------------------------------------------
# COOKIE_SECURE=true whenever the API is served over HTTPS (Render/Vercel).
COOKIE_SECURE=false
COOKIE_DOMAIN=
# "lax" blocks cross-site sends. Use "none" only when the frontend and the API
# sit on different HTTPS origins, which also requires COOKIE_SECURE=true.
COOKIE_SAME_SITE=lax

# --- Security thresholds ---------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_DAYS=30
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=20
ANALYZE_RATE_LIMIT_WINDOW_MINUTES=5
ANALYZE_RATE_LIMIT_MAX=30

# --- Verification and password-reset delivery ------------------------------
# With SMTP_HOST empty, messages are written to server/.outbox/ as plain text
# so the flows stay fully testable without a mail provider. Fill these in to
# send real email in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Digital Guardian <no-reply@example.com>
APP_CLIENT_URL=http://localhost:5173
